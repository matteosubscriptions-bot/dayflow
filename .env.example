# ── Database (PostgreSQL) ───────────────────────────────────
# Dev sessions use a local Postgres (started by the SessionStart hook).
# Production: point this at a managed instance (Supabase/Neon/Railway).
DATABASE_URL="postgresql://dayflow:dayflow@127.0.0.1:5432/dayflow?schema=public"

# ── AI (Anthropic Claude) ───────────────────────────────────
# Optional: when unset the app uses local fallbacks and never blocks
# a flow on a missing key (capture never fails).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Database ────────────────────────────────────────────────
# Dev default uses SQLite so the app runs with zero external setup.
# For production switch the provider in prisma/schema.prisma to
# "postgresql" and point this at Supabase/Railway.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/dayflow"

# ── Auth (NextAuth.js) ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# ── AI (Anthropic Claude) ───────────────────────────────────
# Optional in dev: when unset the app uses local fallbacks and
# never blocks a flow on a missing key.
ANTHROPIC_API_KEY=""

# ── Storage (optional, Supabase) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Database (PostgreSQL) ───────────────────────────────────
# Dev sessions use a local Postgres (started by the SessionStart hook).
# Production: point this at a managed instance (Supabase/Neon/Railway).
DATABASE_URL="postgresql://filo:filo@127.0.0.1:5432/filo?schema=public"
# Migrations on Supabase need the direct (non-pooled) connection:
DIRECT_URL="postgresql://filo:filo@127.0.0.1:5432/filo?schema=public"

# ── Auth (NextAuth.js) ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# ── AI (Anthropic Claude) ───────────────────────────────────
# Optional: when unset the app uses local fallbacks and
# never blocks a flow on a missing key.
ANTHROPIC_API_KEY=""

# ── Speech-to-text server-side (optional) ───────────────────
# Used to transcribe uploaded audio files and notes recorded offline.
# Set ONE of the two. Groq's whisper-large-v3 has a generous free tier.
OPENAI_API_KEY=""
GROQ_API_KEY=""

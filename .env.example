# ── Database (PostgreSQL) ───────────────────────────────────
# Dev sessions use a local Postgres (started by the SessionStart hook).
# Production: point this at a managed instance (Supabase/Neon/Railway).
DATABASE_URL="postgresql://dayflow:dayflow@127.0.0.1:5432/dayflow?schema=public"

# ── Auth (NextAuth.js) ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# ── AI (Anthropic Claude) ───────────────────────────────────
# Optional in dev: when unset the app uses local fallbacks and
# never blocks a flow on a missing key.
ANTHROPIC_API_KEY=""

# ── Storage (optional, Supabase) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

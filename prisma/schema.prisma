generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  theme        String    @default("light") // light | dark
  textScale    Int       @default(100) // percent
  createdAt    DateTime  @default(now())
  notes        Note[]
  projects     Project[]
  tags         Tag[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  notes       Note[]

  @@index([userId])
}

enum NoteStatus {
  DRAFT
  READY
}

enum NoteSource {
  TEXT
  RECORDING
  UPLOAD
}

model Note {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String        @default("Senza titolo")
  contentHtml   String        @default("")
  transcript    String        @default("")
  status        NoteStatus    @default(DRAFT)
  source        NoteSource    @default(TEXT)
  audioData     Bytes?
  audioMime     String?
  audioDuration Int? // seconds
  summary       String?
  keyPoints     Json? // string[]
  todos         Json? // { text: string, done: boolean }[]
  tfVector      Json? // { [term]: count } for semantic search / graph
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tags          NoteTag[]
  generations   Generation[]
  agentThreads  AgentThread[]

  @@index([userId, createdAt])
  @@index([projectId])
}

model Tag {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String // uppercase, no leading #
  notes  NoteTag[]

  @@unique([userId, name])
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

enum GenerationKind {
  SOCIAL
  EMAIL
  ARTICLE
  SPEECH
}

model Generation {
  id        String         @id @default(cuid())
  noteId    String
  note      Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind      GenerationKind
  content   String
  createdAt DateTime       @default(now())

  @@unique([noteId, kind])
}

enum AgentKind {
  PAMELA
  SIMONE
  CORINNE
}

model AgentThread {
  id        String    @id @default(cuid())
  noteId    String
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  agent     AgentKind
  messages  Json      @default("[]") // { role: "user"|"assistant", content: string, at: string }[]
  updatedAt DateTime  @updatedAt

  @@unique([noteId, agent])
}

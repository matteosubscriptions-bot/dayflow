// Officina & Specchio — schema v2 (evoluzione di DayFlow, spec v2.0)
//
// Utente singolo: nessuna tabella utenti/auth. PostgreSQL come "server
// personale" (dev: Postgres locale avviato dal SessionStart hook).
// I campi enum sono String per tenere lo schema semplice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NUCLEO COMUNE ─────────────────────────────────────────────

// Il grezzo vocale/testuale: MAI cancellato, elaborato anche in differita.
model Capture {
  id          String    @id @default(cuid())
  raw         String // trascrizione grezza, così com'è
  source      String    @default("text") // 'voice' | 'text'
  surface     String? // superficie attiva alla cattura ('officina'|'specchio')
  suggested   String? // dominio proposto dal router locale
  ambiguous   Boolean   @default(false)
  status      String    @default("pending") // 'pending' | 'processed'
  domain      String? // dominio scelto ('officina-task'|'officina-idea'|'specchio')
  aiClean     String? // testo pulito dall'Elaboratore
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Il grafo: collega qualsiasi entità a qualsiasi altra.
model Link {
  id        String   @id @default(cuid())
  fromType  String
  fromId    String
  toType    String
  toId      String
  relation  String // 'belongs_to'|'similar_to'|'inspired_by'|'became_task'|'supports_goal'|'from_capture'
  createdBy String   @default("user") // 'user' | 'ai'
  createdAt DateTime @default(now())

  @@index([fromType, fromId])
  @@index([toType, toId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  entityTags EntityTag[]
}

model EntityTag {
  entityType String
  entityId   String
  tagId      String
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId, tagId])
}

// ── IDENTITÀ (proprietà di SPECCHIO, letta da OFFICINA) ──────

model LifeGoal {
  id        String   @id @default(cuid())
  horizon   String // 'vision' | '12m' | 'quarter'
  area      String?
  title     String
  whyDeep   String? // il perché profondo, conservato
  alignment Int? // 1-10
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tasks Task[]
}

// ── 🛠 OFFICINA ───────────────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  name           String
  description    String?
  status         String    @default("active") // 'active'|'paused'|'done'|'dropped'
  lastProgressAt DateTime?
  createdAt      DateTime  @default(now())

  tasks Task[]
}

model Task {
  id             String    @id @default(cuid())
  projectId      String?
  title          String
  urgency        Int       @default(3) // 1-5
  importance     Int       @default(3) // 1-5
  dueDate        DateTime?
  scheduledDate  DateTime?
  status         String    @default("todo") // 'todo'|'done'|'archived'
  deferredCount  Int       @default(0) // "spostato 3+ volte" → domanda, non giudizio
  supportsGoalId String? // → LifeGoal (il ponte fare→identità)
  captureId      String? // grezzo d'origine, se nato da cattura
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supportsGoal LifeGoal? @relation(fields: [supportsGoalId], references: [id], onDelete: SetNull)
}

model Idea {
  id        String   @id @default(cuid())
  title     String
  body      String?
  voiceRaw  String? // grezzo d'origine
  maturity  String   @default("raw") // 'raw'|'developing'|'mature'
  theme     String? // una o due parole, dall'Elaboratore
  captureId String?
  createdAt DateTime @default(now())
}

// ── 🪞 SPECCHIO ───────────────────────────────────────────────

model Dialogue {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  topic      String?
  transcript Json // i turni del dialogo [{role, content, local?}]
  insight    String? // ciò che è emerso, se emerso
  distress   Boolean  @default(false) // sessione passata in modalità ascolto
}

model Mood {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD
  time          String // HH:MM
  label         String? // es. 'check-in' | 'gratitudine'
  moodIntensity Int? // 1-5
  energy        Int? // 1-5 — tracciata SEPARATA dal mood
  context       String? // testo libero (es. la gratitudine)
  createdAt     DateTime @default(now())

  @@index([date])
}

model Habit {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  logs HabitLog[]
}

model HabitLog {
  id      String  @id @default(cuid())
  habitId String
  date    String // YYYY-MM-DD
  done    Boolean @default(true)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

// Il ritratto evolutivo: pattern emersi dai dialoghi, conservati su conferma.
model ProfileTrait {
  id         String   @id @default(cuid())
  trait      String
  evidence   String?
  confidence Float    @default(0.6)
  detectedAt DateTime @default(now())
}

// ── TRASVERSALI ───────────────────────────────────────────────

// Review e report unificati: type distingue, contentJson porta i numeri,
// narrative l'eventuale racconto AI.
model Report {
  id          String   @id @default(cuid())
  type        String // 'weekly' | 'monthly'
  periodStart String // YYYY-MM-DD
  periodEnd   String // YYYY-MM-DD
  contentJson Json?
  narrative   String?
  createdAt   DateTime @default(now())
}
